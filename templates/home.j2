{% extends "base.j2" %}

{% block content %}
  {% if error %}
    <p class="banner" role="alert">{{ error }}</p>
  {% endif %}
  <section class="card">
    {% if not user %}
      <h1>Sign in</h1>
      <p class="lede">You are not signed in.</p>
      <a class="button" href="/login">Sign in with Microsoft</a>
    {% else %}
      <h1>Welcome, {{ user.name or "User" }}</h1>
      <dl class="details">
        <div>
          <dt>Username</dt>
          <dd>{{ user.username or "" }}</dd>
        </div>
        <div>
          <dt>Object ID</dt>
          <dd>{{ user.oid or "" }}</dd>
        </div>
        <div>
          <dt>Tenant ID</dt>
          <dd>{{ user.tid or "" }}</dd>
        </div>
        <div>
          <dt>Roles</dt>
          <dd>{{ user.roles | join(", ") if user.roles else "None" }}</dd>
        </div>
      </dl>
      <div class="actions">
        <a class="button" href="/logout">Local logout</a>
        <a class="button button-secondary" href="/logout/entra">Sign out of Microsoft too</a>
        {% if "App.Admin" in user.roles %}
          <a class="button button-secondary" href="/admin/sessions">Session admin</a>
        {% endif %}
      </div>
    {% endif %}
  </section>
{% endblock %}
