{% extends "base.j2" %}

{% block title %}Profile · FastAPI SSO Lab{% endblock %}

{% block content %}
  <section class="card">
    <h1>{{ user.name or "User" }}</h1>
    <dl class="details">
      <div>
        <dt>Username</dt>
        <dd>{{ user.username or "" }}</dd>
      </div>
      <div>
        <dt>Object ID</dt>
        <dd>{{ user.oid or "" }}</dd>
      </div>
      <div>
        <dt>Tenant ID</dt>
        <dd>{{ user.tid or "" }}</dd>
      </div>
      <div>
        <dt>Roles</dt>
        <dd>{{ user.roles | join(", ") if user.roles else "None" }}</dd>
      </div>
    </dl>
  </section>
{% endblock %}
