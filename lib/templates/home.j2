{% extends "base.j2" %}

{% block content %}
  {% if banner %}
    <p class="banner banner-{{ banner_role }}" role="{{ 'status' if banner_role == 'info' else 'alert' }}">{{ banner }}</p>
  {% endif %}
  <section class="card">
    {% if not user %}
      <h1>Sign in</h1>
      <p class="lede">You are not signed in.</p>
      <a class="button" href="/login">Sign in with Microsoft</a>
    {% else %}
      <h1>Welcome, {{ user.name or "User" }}</h1>
      <dl class="details">
        <div>
          <dt>Username</dt>
          <dd>{{ user.username or "" }}</dd>
        </div>
        <div>
          <dt>Object ID</dt>
          <dd>{{ user.oid or "" }}</dd>
        </div>
        <div>
          <dt>Tenant ID</dt>
          <dd>{{ user.tid or "" }}</dd>
        </div>
        <div>
          <dt>Roles</dt>
          <dd>{{ user.roles | join(", ") if user.roles else "None" }}</dd>
        </div>
      </dl>
      <div class="actions">
        <form method="post" action="/logout">
          <button class="button" type="submit">Local logout</button>
        </form>
        <form method="post" action="/logout/entra">
          <button class="button button-secondary" type="submit">Sign out of Microsoft too</button>
        </form>
        {% if admin_role in user.roles %}
          <a class="button button-secondary" href="/admin/sessions">Session admin</a>
        {% endif %}
      </div>
    {% endif %}
  </section>
{% endblock %}
