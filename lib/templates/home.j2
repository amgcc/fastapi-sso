{% extends "base.j2" %}

{% block content %}
  {% if banner %}
    <p class="banner banner-{{ banner_role }}" role="{{ 'status' if banner_role == 'info' else 'alert' }}">{{ banner }}</p>
  {% endif %}
  <section class="card">
    {% if not user %}
      <h1>Sign in</h1>
      <p class="lede">You are not signed in.</p>
      <a class="button" href="/login">Sign in with Microsoft</a>
    {% else %}
      <h1>Welcome, {{ user.name or "User" }}</h1>
      <div class="actions">
        <a class="button button-secondary" href="/profile">Profile</a>
        <form method="post" action="/logout">
          <button class="button" type="submit">Logout</button>
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        </form>
        <form method="post" action="/logout/entra">
          <button class="button button-secondary" type="submit">Entra Logout</button>
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        </form>
        {% if admin_role in user.roles %}
          <a class="button button-secondary" href="/admin/sessions">Session admin</a>
        {% endif %}
      </div>
    {% endif %}
  </section>
{% endblock %}
